# =============================================================================
# ENVIRONMENT
# =============================================================================

NODE_ENV=development
APP_NAME=Statspiracy
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
PORT=3000

# =============================================================================
# FRONTEND
# =============================================================================

VITE_APP_NAME=Statspiracy
VITE_API_URL=http://localhost:8000
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI=true

# =============================================================================
# AUTHENTICATION
# =============================================================================

AUTH_SECRET=
AUTH_URL=http://localhost:3000

JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

SESSION_SECRET=
SESSION_MAX_AGE=604800

# =============================================================================
# DATABASE - NEON POSTGRESQL
# =============================================================================


# =============================================================================
# DATABASE - NEONDB + POSTGRESQL 
# =============================================================================

# Primary pooled connection - use for app/API runtime
DATABASE_URL=

# Direct connection - use for migrations, schema changes, seed scripts
DATABASE_DIRECT_URL=

# Pooled connection - optional explicit pool URL
DATABASE_POOL_URL=

# Neon project details
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_DATABASE_NAME=statspiracy
NEON_DATABASE_USER=
NEON_DATABASE_PASSWORD=

# Connection settings
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=statspiracy
POSTGRES_USER=
POSTGRES_PASSWORD=

# SSL required for Neon
POSTGRES_SSLMODE=require

# ORM / migration tools
PRISMA_DATABASE_URL=
DRIZZLE_DATABASE_URL=
ALEMBIC_DATABASE_URL=

# FastAPI / SQLAlchemy
SQLALCHEMY_DATABASE_URL=
ASYNC_DATABASE_URL=

# Pool settings
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30
DB_IDLE_TIMEOUT=300

# Neon API - only needed for automation/admin scripts
NEON_API_KEY=

# Environment branch names
NEON_BRANCH_DEV=dev
NEON_BRANCH_STAGING=staging
NEON_BRANCH_PRODUCTION=main
DATABASE_URL=
DATABASE_POOL_URL=
DATABASE_DIRECT_URL=

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=statspiracy
POSTGRES_USER=
POSTGRES_PASSWORD=

# =============================================================================
# REDIS
# =============================================================================

REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# OBJECT STORAGE
# =============================================================================

STORAGE_PROVIDER=s3

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# =============================================================================
# AI PROVIDERS
